# Copy this file to .env and fill in local credentials.
# .env is ignored by Git and must never be committed.
DB_URL=jdbc:mysql://localhost:3306/bna_digital_banking?serverTimezone=UTC
DB_USERNAME=bna_app
DB_PASSWORD=changeme

# Optional: leave empty to generate an ephemeral development JWT secret at startup.
JWT_SECRET=

# Gemini native API configuration.
LLM_ENABLED=true
LLM_PROVIDER=gemini
LLM_API_KEY=replace-with-your-gemini-api-key
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_READ_TIMEOUT=30s
